# Langdesk configuration. Copy to .env and edit; every value is optional for a local trial.
# Full reference: docs/configuration.md

# --- Your organisation --------------------------------------------------------
LANGDESK_ORG_NAME=Riverside Community Health
# Public address of this server. Used in text and email links and calendar feeds.
LANGDESK_BASE_URL=http://localhost:8000
LANGDESK_TIME_ZONE=America/New_York
# Shown in help replies and emails, e.g. "Language access desk, 555-0100 ext. 4400"
LANGDESK_SUPPORT_CONTACT=

# --- Django -------------------------------------------------------------------
# Leave empty and the container generates one and keeps it in the data volume.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set these once you serve Langdesk over HTTPS:
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000

# --- Database and queue (Docker Compose sets these for you) -------------------
POSTGRES_PASSWORD=langdesk
# DATABASE_URL=postgres://langdesk:langdesk@db:5432/langdesk
# CELERY_BROKER_URL=redis://redis:6379/0

# --- Email --------------------------------------------------------------------
# The console backend prints emails to the logs. Use SMTP for real delivery.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Langdesk <langdesk@example.org>

# --- Text messages ------------------------------------------------------------
# console (default) logs texts; twilio sends them; webhook relays them to any provider.
LANGDESK_SMS_BACKEND=langdesk.messaging.backends.console.ConsoleSMSBackend
# LANGDESK_SMS_BACKEND=langdesk.messaging.backends.twilio.TwilioSMSBackend
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15555550100
# TWILIO_MESSAGING_SERVICE_SID=
# LANGDESK_SMS_BACKEND=langdesk.messaging.backends.webhook.WebhookSMSBackend
# LANGDESK_SMS_WEBHOOK_URL=https://relay.example.org/send
# LANGDESK_SMS_WEBHOOK_TOKEN=
# Bearer token for replies posted to /sms/inbound/ by a non-Twilio provider.
# LANGDESK_SMS_INBOUND_TOKEN=
# Lets coordinators reply to offers from the browser. Turn off in production.
LANGDESK_SMS_SIMULATOR=true
LANGDESK_DEFAULT_COUNTRY_CODE=1

# --- Video fallback -----------------------------------------------------------
LANGDESK_JITSI_BASE_URL=https://meet.jit.si

# --- Dispatch rules -----------------------------------------------------------
LANGDESK_AUTO_DISPATCH=true
LANGDESK_OFFER_WAVE_SIZE=3
LANGDESK_OFFER_TIMEOUT_MINUTES=20
LANGDESK_VIDEO_FALLBACK_MINUTES=60
LANGDESK_TRAVEL_BUFFER_MINUTES=15
LANGDESK_REMINDER_MINUTES=1440,120

# --- Docker Compose -----------------------------------------------------------
# Image tag to run (a release such as 1.0.0, or latest / edge).
LANGDESK_VERSION=latest
LANGDESK_PORT=8000
